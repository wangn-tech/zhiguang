# 本地启用阿里云 OSS 时改为 true。
OSS_ENABLED=true

# 使用最小权限 RAM 用户的 AccessKey。真实值只保存在未跟踪的 .env 中。
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=

# Bucket 所在地域及访问配置。
OSS_REGION=cn-beijing
OSS_ENDPOINT=https://oss-cn-beijing.aliyuncs.com
OSS_BUCKET=

# 可选：自定义域名或 CDN 地址，例如 https://static.example.com。
OSS_PUBLIC_BASE_URL=
