<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.wangning.user.mapper.UserMapper">

    <resultMap id="UserResultMap" type="com.wangning.user.domain.User">
        <id column="id" property="id"/>
        <result column="phone" property="phone"/>
        <result column="email" property="email"/>
        <result column="password_hash" property="passwordHash"/>
        <result column="nickname" property="nickname"/>
        <result column="avatar" property="avatar"/>
        <result column="bio" property="bio"/>
        <result column="zg_id" property="zgId"/>
        <result column="gender" property="gender"/>
        <result column="birthday" property="birthday"/>
        <result column="school" property="school"/>
        <result column="tags_json" property="tagsJson"/>
        <result column="created_at" property="createdAt"/>
        <result column="updated_at" property="updatedAt"/>
    </resultMap>

    <sql id="UserColumns">
        id,
        phone,
        email,
        password_hash,
        nickname,
        avatar,
        bio,
        zg_id,
        gender,
        birthday,
        school,
        tags_json,
        created_at,
        updated_at
    </sql>

    <select id="findById" resultMap="UserResultMap">
        SELECT
        <include refid="UserColumns"/>
        FROM users
        WHERE id = #{id}
    </select>

    <select id="findByPhone" resultMap="UserResultMap">
        SELECT
        <include refid="UserColumns"/>
        FROM users
        WHERE phone = #{phone}
        LIMIT 1
    </select>

    <select id="findByEmail" resultMap="UserResultMap">
        SELECT
        <include refid="UserColumns"/>
        FROM users
        WHERE email = #{email}
        LIMIT 1
    </select>

    <select id="existsByPhone" resultType="boolean">
        SELECT EXISTS(
            SELECT 1
            FROM users
            WHERE phone = #{phone}
        )
    </select>

    <select id="existsByEmail" resultType="boolean">
        SELECT EXISTS(
            SELECT 1
            FROM users
            WHERE email = #{email}
        )
    </select>

    <insert id="insert"
            parameterType="com.wangning.user.domain.User"
            useGeneratedKeys="true"
            keyProperty="id"
            keyColumn="id">
        INSERT INTO users (
            phone,
            email,
            password_hash,
            nickname,
            avatar,
            bio,
            zg_id,
            gender,
            birthday,
            school,
            tags_json,
            created_at,
            updated_at
        ) VALUES (
            #{phone},
            #{email},
            #{passwordHash},
            #{nickname},
            #{avatar},
            #{bio},
            #{zgId},
            #{gender},
            #{birthday},
            #{school},
            #{tagsJson},
            #{createdAt},
            #{updatedAt}
        )
    </insert>

</mapper>
